            "hash": "f89694b7265d4f503719b993e015cedcb8b2d757325070670cc1af04bb13ad64"
        },
        "arm64": {
            "url": "https://github.com/t8y2/motty/releases/download/v0.3.2/motty-0.3.2-windows-arm64.zip",
